+/* Raw exit status, for helpers whose exit code carries a classification
+ * (modem_safety "probe"/"enable": 1 = not ready yet, 2 = unsupported). */
+static int wait_program_status(pid_t child)
+{
+	int status;
+	while (waitpid(child, &status, 0) < 0) {
+		if (errno != EINTR)
+			return -1;
+	}
+	if (!WIFEXITED(status))
+		return -1;
+	return WEXITSTATUS(status);
+}
