+static void schedule_activation_retry(struct qmodem_voip_context *app)
+{
+	unsigned int exponent;
+	unsigned int delay_ms;
+
+	if (app->activation_attempts >= QMODEM_VOIP_ACTIVATION_MAX_ATTEMPTS) {
+		/* Give up for this boot without touching UCI: enabled stays 1, so
+		 * the next service start (or reboot) tries again. */
+		syslog(LOG_WARNING,
+			"voice still not ready after %u attempts; keeping config enabled, retry on next start",
+			app->activation_attempts);
+		return;
+	}
+	exponent = app->activation_attempts;
+	if (exponent > 8)
+		exponent = 8;
+	delay_ms = QMODEM_VOIP_ACTIVATION_MIN_DELAY_MS << exponent;
+	if (delay_ms > QMODEM_VOIP_ACTIVATION_MAX_DELAY_MS)
+		delay_ms = QMODEM_VOIP_ACTIVATION_MAX_DELAY_MS;
+	app->activation_attempts++;
+	syslog(LOG_NOTICE,
+		"voice activation deferred; retry %u/%u in %u ms",
+		app->activation_attempts, QMODEM_VOIP_ACTIVATION_MAX_ATTEMPTS,
+		delay_ms);
