diff --git a/application/qmodem/files/etc/init.d/qmodem_network b/application/qmodem/files/etc/init.d/qmodem_network
index 9e18f93..a1191e1 100755
--- a/application/qmodem/files/etc/init.d/qmodem_network
+++ b/application/qmodem/files/etc/init.d/qmodem_network
@@ -51,7 +51,16 @@ update_modem(){
 dial()
 {
     qmodem_valid_instance "$1" || return 2
-	rc_procd _dial $1
+    # When start_service/stop_service/reload_service is already building this
+    # service's procd definition, adding a nested rc_procd here would call
+    # procd_open_service again, re-initialise the JSON buffer and make the
+    # outer procd_close_service send "{}" (ubus: Invalid argument). Add the
+    # instance to the outer definition instead.
+    if [ -n "$_PROCD_SERVICE" ]; then
+        _dial $1
+    else
+        rc_procd _dial $1
+    fi
 }
 
 hang()
@@ -92,9 +101,18 @@ _update_modem()
     if [ "$state" = "disabled" ] || [ "$enabled" = "0" ] || [ "$g_enabled" = "0" ] || [ "$force_stop" = "1" ];then
         target=0
     fi
-    data=$(_procd_ubus_call list | jq -r  ".$service.instances.modem_$1")
+    logger -t qmodem_network "cfg:$1 target:$target"
+    if [ -n "$_PROCD_SERVICE" ]; then
+        # Assembling this service's procd definition: declare every enabled
+        # modem so a reload does not drop running instances. A disabled modem
+        # is simply left out; procd stops any instance the new definition no
+        # longer lists. Never call _procd_ubus_call here: it json_cleanup()s
+        # the outer buffer and the close then sends "{}".
+        [ "$target" -eq 1 ] && _dial $1
+        return 0
+    fi
+    data=$(ubus call service list '{}' | jq -r  ".$service.instances.modem_$1")
     [ "$data" == "null" ] && current_status=0 || current_status=1
-    logger -t qmodem_network "cfg:$1 current:$current_status;target:$target "
     if [ "$current_status" != "$target" ];then
         [ "$target" -eq 1 ] && dial $1 || hang $1
         logger -t qmodem_network "update modem cfg: $1 dial:$target"
@@ -126,6 +144,6 @@ _modem_status()
 { 
 	local instances="modem_$1"
 	local data
-    data=$(_procd_ubus_call list | jq  -r ".$service.instances.$instances")
+    data=$(ubus call service list '{}' | jq  -r ".$service.instances.$instances")
     [ "$data" == "null" ] && echo "$instances Not Running"  || echo "$data"
 }
