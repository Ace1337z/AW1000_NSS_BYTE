index 2d92af6..fa050f0 100644
--- a/application/qmodem_sipd/Makefile
+++ b/application/qmodem_sipd/Makefile
@@ -66,6 +66,16 @@ define Package/$(PKG_NAME)/install
 	$(INSTALL_BIN) ./files/etc/uci-defaults/89-qmodem-sip-migrate $(1)/etc/uci-defaults/
 	$(INSTALL_BIN) ./files/etc/uci-defaults/90-qmodem-sip-firewall $(1)/etc/uci-defaults/
 	$(INSTALL_BIN) ./files/etc/uci-defaults/91-qmodem-sip-bootlink $(1)/etc/uci-defaults/
+	$(INSTALL_BIN) ./files/etc/uci-defaults/92-qmodem-sip-secure $(1)/etc/uci-defaults/
+endef
+
+define Package/$(PKG_NAME)/postinst
+#!/bin/sh
+# The inbound SIP password is a shared credential; keep the plaintext
+# root-only. uci-defaults repeats this on every first boot, this covers
+# package installation.
+chmod 600 /etc/config/qmodem_sip 2>/dev/null
+exit 0
 endef
 
 $(eval $(call BuildPackage,$(PKG_NAME)))
