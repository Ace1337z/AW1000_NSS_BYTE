diff --git a/application/qmodem_sipd/files/etc/uci-defaults/92-qmodem-sip-secure b/application/qmodem_sipd/files/etc/uci-defaults/92-qmodem-sip-secure
new file mode 100755
index 0000000..d9c4f68
--- /dev/null
+++ b/application/qmodem_sipd/files/etc/uci-defaults/92-qmodem-sip-secure
@@ -0,0 +1,9 @@
+#!/bin/sh
+
+# The inbound SIP password is a shared, universal credential: it lives only in
+# /etc/config/qmodem_sip (never in sip.conf, which carries username= + ha1=
+# only). Keep the file root-only so the plaintext cannot leak to unprivileged
+# readers.
+chmod 600 /etc/config/qmodem_sip 2>/dev/null
+
+exit 0
