 #!/bin/sh /etc/rc.common
+# QModem TTL: rewrite egress TTL/hop limit on the modem interface.
+#
+# BYTE local patch: the chain is the upstream rule set replaced by a single
+# forward/mangle chain keyed on the WWAN interface (oifname "wwan0_1") instead
+# of the br-lan postrouting rewrite, and the service no longer touches flow
+# offloading or the vendor ECM/shortcut-fe modules: this image is built around
+# PPE/NSS hardware offload and unloading it would defeat the build.
+# Consequence: flows that ARE offloaded in hardware bypass netfilter, so their
+# TTL is not rewritten after the first packet. Keep offload off on the WWAN
+# path (firewall.@defaults[0].flow_offloading/flow_offloading_hw) if the
+# carrier must see a constant TTL on every packet.
 START=95
 STOP=13
 USE_PROCD=1
-
 . $IPKG_INSTROOT/usr/share/libubox/jshn.sh
 . $IPKG_INSTROOT/lib/functions.sh
-
-nftfile="/etc/nftables.d/99-reset-ttl-from-br-lan.nft"
+nftfile="/etc/nftables.d/99-qmodem-ttl.nft"
+legacy="/etc/nftables.d/99-reset-ttl-from-br-lan.nft"
 start_service()
 {
     config_load 'qmodem_ttl'
     config_get enable 'main' 'enable' '0'
+    rm -f "$legacy"
     if [ "$enable" == 0 ]; then
+        rm -f "$nftfile"
         return
     fi
     set_if_ttl
 }
-
 set_if_ttl()
 {
-    config_get ttl 'main' 'ttl'
-    logger -t modem_ttl "Ovrewirte TTL from br-lan to $ttl"
-    comment="modem_ttl"
-    #nftables
+    config_get ttl 'main' 'ttl' '64'
+    config_get iface 'main' 'iface' 'wwan0_1'
+    logger -t modem_ttl "Override TTL to $ttl on $iface"
     cat << EOF > $nftfile
-chain postrouting {
-    type filter hook postrouting priority mangle; policy accept;
-    iifname "br-lan" ip ttl set $ttl comment "Reset TTL for br-lan IPv4"
-    iifname "br-lan" ip6 hoplimit set $ttl comment "Reset Hop Limit for br-lan IPv6"
-}
+chain mangle_forward {
+    type filter hook forward priority mangle; policy accept;
 
+    oifname "$iface" ip ttl != $ttl ip ttl set $ttl
+    oifname "$iface" ip6 hoplimit != $ttl ip6 hoplimit set $ttl
+}
 EOF
-    /etc/firewall.d/qmodem_ttl
-    [ -d /sys/kernel/debug/ecm/ ] && /etc/init.d/qca-nss-ecm stop
-    [ -d /sys/module/shortcut_fe_cm ] && rmmod shortcut_fe_cm
-    [ -d /sys/module/fast_classifier ] && rmmod fast_classifier
-    uci set firewall.@defaults[0].flow_offloading='0'
-    uci set firewall.@defaults[0].flow_offloading_hw='0'
-    uci commit firewall
     /etc/init.d/firewall restart
 }
