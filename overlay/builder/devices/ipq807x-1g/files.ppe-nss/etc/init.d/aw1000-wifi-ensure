#!/bin/sh /etc/rc.common
# AW1000: make sure the configured APs are actually up after first boot.
#
# The radios on this board are loaded by /etc/init.d/nss-wifi (START=19), not
# by the boot-time kmodloader. That means the ieee80211 hotplug which writes
# /etc/config/wireless runs at roughly the same time as netifd starts
# (/etc/init.d/network, START=20). netifd builds its wireless device objects
# only from the wifi-device sections it reads on a reload, so if it read the
# file before the hotplug finished writing it, it has no radio at all.
# `ubus call network.wireless retry` does not re-read UCI and cannot create a
# missing device, so that race used to leave the box with no SSID until a
# manual `wifi reload` or a reboot.
#
# This service is the bounded safety net, not the primary fix: the image ships
# a default /etc/config/wireless. It waits for at least one phy, regenerates
# the config only if it somehow has no wifi-device sections, then reloads
# netifd once so it re-reads the file. A second reload is allowed only if the
# first one did not bring any AP up. It never loops and never unloads a driver.
#
# START=26: after network (20) and nss-wifi (19), before user services.
START=26

RADIO_MAX_WAIT=45
AP_MAX_WAIT=45
LOG=/tmp/log/aw1000-wifi-ensure.log

radio_count() {
	ls -d /sys/class/ieee80211/phy* 2>/dev/null | wc -l
}

aps_up() {
	local d

	for d in /sys/class/net/phy*-ap*; do
		[ -e "$d" ] && return 0
	done
	return 1
}

config_has_radios() {
	uci -q show wireless 2>/dev/null | grep -q '=wifi-device'
}

generate_config() {
	config_has_radios && return 0
	logger -t aw1000-wifi-ensure \
		"no wifi-device sections; generating wireless config from board data"
	/sbin/wifi config
	config_has_radios
}

netifd_ready() {
	ubus call network.wireless status >/dev/null 2>&1
}

wait_aps() {
	local max="$1" i=0

	while ! aps_up && [ "$i" -lt "$max" ]; do
		sleep 3
		i=$((i + 3))
	done
	aps_up
}

start() {
	local n

	mkdir -p /tmp/log

	# Wait for the phy nodes. Firmware load happens in the kernel and can
	# exceed the usual probe window on a slow first boot.
	i=0
	while [ "$(radio_count)" -eq 0 ] && [ "$i" -lt "$RADIO_MAX_WAIT" ]; do
		sleep 3
		i=$((i + 3))
	done
	n=$(radio_count)
	if [ "$n" -eq 0 ]; then
		logger -t aw1000-wifi-ensure \
			"no phy after ${RADIO_MAX_WAIT}s; wifi reload cannot help"
		dmesg | grep -iE "ath11k|nss-wifi" | tail -40 > "$LOG" 2>/dev/null
		exit 0
	fi

	# The hotplug writes the config after the phy appears; if it lost the
	# race (or the file is empty because netifd read it too early), the
	# config has no radios yet. Generate it now that phy nodes exist.
	generate_config

	if aps_up; then
		logger -t aw1000-wifi-ensure "APs up (${n} phy)"
		exit 0
	fi

	if netifd_ready; then
		logger -t aw1000-wifi-ensure \
			"APs down with ${n} phy; reloading network so it re-reads wireless config"
		ubus call network reload >/dev/null 2>&1
	else
		logger -t aw1000-wifi-ensure \
			"APs down and netifd not answering; waiting for network start"
	fi

	if wait_aps "$AP_MAX_WAIT"; then
		logger -t aw1000-wifi-ensure "APs up after network reload"
		exit 0
	fi

	# Last attempt: the config may have been written after the first reload
	# had already re-read it (slow overlay on a first boot).
	generate_config
	if netifd_ready; then
		logger -t aw1000-wifi-ensure "APs still down; second network reload"
		ubus call network reload >/dev/null 2>&1
	fi
	if wait_aps "$AP_MAX_WAIT"; then
		logger -t aw1000-wifi-ensure "APs up after second network reload"
	else
		logger -t aw1000-wifi-ensure "APs still down; inspect $LOG"
		dmesg | grep -iE "ath11k|nss-wifi|hostapd" | tail -60 > "$LOG" \
			2>/dev/null
	fi
	exit 0
}

stop() {
	:
}
