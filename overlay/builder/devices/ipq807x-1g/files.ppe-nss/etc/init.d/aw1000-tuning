#!/bin/sh /etc/rc.common
# AW1000: CPU frequency policy.
#
# The sysctls (BBR, fq, Fast Open, netdev backlog/budget) live in
# /etc/sysctl.d/99-aw1000-tuning.conf and are applied by /etc/init.d/sysctl.
# This script only handles the cpufreq policy, which is runtime state the
# kernel does not persist: the governor and the min/max frequencies.
#
# performance + min=max=2.2 GHz means the CPU never scales down and never has
# to ramp back up, so the first packet after idle is not delayed by a frequency
# transition. Costs a little idle power; buys zero ramp latency.
#
# CPU spread is not done here. It moved to two dedicated services so each
# concern has one owner:
#   smp-affinity (START=93) - ath11k Wi-Fi rings and edma LAN/WAN IRQs, one
#     core each, by interrupt name.
#   aw1000-affinity (START=96) - modem packet work via RPS/XPS/RFS on the wwan
#     devices. Writing an all-cores mask to a single modem IRQ does nothing
#     (the kernel collapses effective_affinity back to one CPU), so RPS is what
#     actually distributes that path.
START=99
STOP=10

set_policy() {
	local base
	for base in /sys/devices/system/cpu/cpufreq/policy[0-9]*; do
		[ -d "$base" ] || continue
		[ -w "$base/scaling_governor" ] || continue
		[ "$(cat "$base/scaling_governor")" = performance ] ||
			echo performance > "$base/scaling_governor" 2>/dev/null
		# Pin min = max so the governor cannot drop to the low OPP.
		for f in scaling_min_freq scaling_max_freq; do
			[ -w "$base/$f" ] && echo 2208000 > "$base/$f" 2>/dev/null
		done
	done
	# Older layout: per-cpu cpufreq dirs instead of policies.
	for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
		[ -w "$gov" ] || continue
		[ "$(cat "$gov")" = performance ] || echo performance > "$gov" 2>/dev/null
	done
}

start() {
	set_policy
}

stop() {
	:
}
