#!/bin/sh /etc/rc.common
# Spread modem packet processing across all CPU cores.
#
# The AW1000's USB modem subscribes every data interrupt to a single core
# (observed: all xhci-hcd:usb3 interrupts landing on cpu2 with
# smp_affinity=4). With userspace crypto on top, one core saturates long before
# the link does. OpenWrt's stock set-irq-affinity only walks devices listed in
# /etc/board.json (lan/wan switch ports); wwan0_1 is never covered. This service
# closes that gap and re-applies on netifd events, because the wwan interfaces
# are created after boot when qmodem dials.
#
# Deliberately NOT touching IRQ affinity here: writing an all-cores mask to a
# single modem IRQ (e.g. xhci-hcd:usb3) makes the kernel collapse
# effective_affinity back to one CPU, so it achieves nothing. RPS/XPS below is
# what distributes the work. RPS/RFS does not bypass netfilter, so any
# connection-tracking / TTL rewrite still applies.
START=96
STOP=12
USE_PROCD=1

RPS_MASK=0f          # all four cores
RPS_FLOW=4096

apply() {
	# Global RFS table. Without this rps_flow_cnt is inert.
	echo "$RPS_FLOW" > /proc/sys/net/core/rps_sock_flow_entries 2>/dev/null

	for dev in /sys/class/net/*; do
		name=${dev##*/}
		# Only the modem data interfaces matter. Touching wlan*/eth* would
		# fight the NSS/ath11k steering that smp-affinity sets per-IRQ.
		case "$name" in
			wwan*|rmnet*) ;;
			*) continue ;;
		esac

		for q in "$dev"/queues/rx-*/rps_cpus; do
			[ -e "$q" ] || continue
			echo "$RPS_MASK" > "$q" 2>/dev/null
		done
		for q in "$dev"/queues/rx-*/rps_flow_cnt; do
			[ -e "$q" ] || continue
			echo "$RPS_FLOW" > "$q" 2>/dev/null
		done
		# Transmit-side steering: keeps xmit softirq off the same core as rx.
		for q in "$dev"/queues/tx-*/xps_cpus; do
			[ -e "$q" ] || continue
			echo "$RPS_MASK" > "$q" 2>/dev/null
		done
	done
}

start_service() {
	apply
	# Re-apply on a timer: the wwan device can be recreated on every redial.
	procd_open_instance
	procd_set_param command /bin/sh -c '
		while true; do
			sleep 15
			/etc/init.d/aw1000-affinity reload
		done'
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

reload_service() {
	apply
}

stop_service() {
	for dev in /sys/class/net/wwan*; do
		for q in "$dev"/queues/rx-*/rps_cpus; do
			[ -e "$q" ] && echo 0 > "$q" 2>/dev/null
		done
	done
}

service_triggers() {
	procd_add_reload_trigger "network"
	procd_add_raw_trigger "interface.*" 2000 /etc/init.d/aw1000-affinity reload
}
