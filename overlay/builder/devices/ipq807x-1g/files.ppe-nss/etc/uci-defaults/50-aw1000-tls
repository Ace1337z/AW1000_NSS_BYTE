#!/bin/sh
# HTTPS certificate for the names the box is actually reached by, signed by
# a locally generated BYTE CA.
#
# Why this exists: /etc/init.d/uhttpd's generate_keys() derives the self-signed
# cert from uhttpd.defaults.commonname and hardcodes
#   -addext subjectAltName=DNS:"$commonname"
# so the stock cert only ever carries DNS:OpenWrt. Reaching the box the normal
# way, https://192.168.1.1, then fails hostname verification and the browser
# shows "Not secure" even though TLS is up and the HTTP->HTTPS redirect works.
#
# This script creates a local CA (BYTE CA) once, then mints server certificates
# signed by it, with
#   DNS:BYTE  DNS:BYTE.lan  IP:<every address on network.lan>
# Browsers still warn about the unknown issuer until the CA is imported once:
#   https://192.168.1.1/luci-static/ca.crt
# (the CA certificate is served from LuCI's web root). After that import the
# UI is fully trusted with no warnings.
#
# Regeneration policy: CA is regenerated only when missing or expired; the
# server certificate only when the desired SAN set changes (LAN address
# edited), the files are missing/empty, the cert is under 7 days from expiry,
# or the issuing CA changed. Regenerating on every boot would throw away the
# browser exception the user accepted on the previous boot.
#
# Runs from /etc/uci-defaults via /etc/init.d/boot (START=10), i.e. before
# uhttpd starts (START=50); the restart below only matters on the sysupgrade
# path, where uhttpd may already be running when these scripts are re-run.

CERT=/etc/uhttpd.crt
KEY=/etc/uhttpd.key
CACERT=/etc/uhttpd-ca.crt
CAKEY=/etc/uhttpd-ca.key
CADIR=/www/luci-static
CACRT_COPY=$CADIR/ca.crt

[ -x /usr/bin/openssl ] || exit 0

san=""
add_san() {
	case ",$san," in
	*",$1,"*) ;;
	*) san="${san:+$san,}$1" ;;
	esac
}

add_san "DNS:BYTE"
add_san "DNS:BYTE.lan"

for addr in $(uci -q get network.lan.ipaddr); do
	ip="${addr%%/*}"
	case "$ip" in
	'' | *[!0-9a-fA-F:.]*) continue ;;
	esac
	add_san "IP:$ip"
done

# Marker lives in /etc/config/system, so a settings-keeping sysupgrade keeps
# it and skips regeneration when nothing changed.
cur="$(uci -q get system.@system[0].aw1000_tls_san)"
cur_ca="$(uci -q get system.@system[0].aw1000_tls_ca)"

# --- CA (re)generation ------------------------------------------------
ca_ok=0
if [ -s "$CACERT" ] && [ -s "$CAKEY" ] &&
	openssl x509 -in "$CACERT" -noout -checkend 315360000 >/dev/null 2>&1; then
	ca_ok=1
fi

if [ "$ca_ok" = 0 ]; then
	tmpd="$(mktemp -d /etc/.aw1000-tls-ca.XXXXXX)" || exit 0
	trap 'rm -rf "$tmpd"' EXIT
	if ! openssl req -x509 -sha256 -days 3650 -nodes \
		-newkey ec -pkeyopt ec_paramgen_curve:P-256 \
		-keyout "$tmpd/ca.key" -out "$tmpd/ca.crt" \
		-subj "/C=US/ST=BYTE/L=BYTE/O=BYTE/CN=BYTE CA" \
		-addext "basicConstraints=critical,CA:TRUE" \
		-addext "keyUsage=critical,keyCertSign,cRLSign" \
		-addext "subjectKeyIdentifier=hash" >/dev/null 2>&1; then
		logger -t aw1000-tls "CA generation failed, keeping existing files"
		exit 0
	fi
	chmod 600 "$tmpd/ca.key"
	mv -f "$tmpd/ca.key" "$CAKEY"
	mv -f "$tmpd/ca.crt" "$CACERT"
	logger -t aw1000-tls "generated BYTE CA"
fi

ca_fp="$(openssl x509 -in "$CACERT" -noout -fingerprint -sha256 2>/dev/null |
	sed 's/^.*=//')"

# --- Server certificate (re)generation --------------------------------
leaf_ok=0
if [ -s "$CERT" ] && [ -s "$KEY" ] && [ "$cur" = "$san" ] &&
	[ "$cur_ca" = "$ca_fp" ] &&
	openssl x509 -in "$CERT" -noout -checkend 604800 >/dev/null 2>&1 &&
	[ "$(openssl x509 -in "$CERT" -noout -issuer 2>/dev/null)" = \
	  "$(openssl x509 -in "$CACERT" -noout -subject 2>/dev/null)" ]; then
	leaf_ok=1
fi

if [ "$leaf_ok" = 0 ]; then
	tmpd="$(mktemp -d /etc/.aw1000-tls.XXXXXX)" || exit 0
	trap 'rm -rf "$tmpd"' EXIT

	if ! openssl ecparam -name prime256v1 -genkey -noout \
		-out "$tmpd/key" 2>/dev/null || \
	   ! openssl req -new -sha256 -key "$tmpd/key" \
		-subj "/C=US/ST=BYTE/L=BYTE/O=BYTE/CN=BYTE" \
		-addext "subjectAltName=$san" \
		-addext "extendedKeyUsage=serverAuth" \
		-addext "basicConstraints=critical,CA:FALSE" \
		-out "$tmpd/leaf.csr" 2>/dev/null || \
	   ! openssl x509 -req -in "$tmpd/leaf.csr" -sha256 \
		-CA "$CACERT" -CAkey "$CAKEY" -CAcreateserial \
		-days 825 -copy_extensions copy \
		-out "$tmpd/crt" 2>/dev/null; then
		logger -t aw1000-tls "certificate generation failed, keeping existing files"
		exit 0
	fi

	chmod 600 "$tmpd/key"
	mv -f "$tmpd/key" "$KEY"
	mv -f "$tmpd/crt" "$CERT"

	uci -q set system.@system[0].aw1000_tls_san="$san"
	uci -q set system.@system[0].aw1000_tls_ca="$ca_fp"
	uci -q commit system
fi

# Serve the CA so clients can import it once. Refresh the copy whenever the
# file or the CA changed.
if [ ! -f "$CACRT_COPY" ] || ! cmp -s "$CACERT" "$CACRT_COPY"; then
	mkdir -p "$CADIR"
	cp -f "$CACERT" "$CACRT_COPY"
	chmod 644 "$CACRT_COPY"
fi

# Keep the stock generator aligned for the case these files are ever deleted:
# a regenerated cert then still says CN=BYTE / DNS:BYTE instead of OpenWrt.
uci -q set uhttpd.defaults.commonname='BYTE'
uci -q set uhttpd.main.cert="$CERT"
uci -q set uhttpd.main.key="$KEY"
uci -q commit uhttpd

pidof uhttpd >/dev/null 2>&1 && /etc/init.d/uhttpd restart >/dev/null 2>&1
exit 0
