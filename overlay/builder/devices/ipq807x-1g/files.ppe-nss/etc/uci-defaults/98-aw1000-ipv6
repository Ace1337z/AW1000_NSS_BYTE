#!/bin/sh
# IPv6 is auto-detected at start, never required.
#
# The default /etc/config/network shipped with this image already defines the
# modem's DHCPv6 uplink as 'wanv6' (device @wan, proto dhcpv6, extendprefix),
# matching the reference firmware. So there is nothing to create here any more;
# this script only makes sure LAN can take a delegated prefix and sets the
# marker so the check stays cheap.
#
# "Prefer IPv4 when there is no usable IPv6" is handled at runtime by
# /usr/sbin/aw1000-ipv6-prefer, called from /etc/init.d/aw1000-ipv6 (boot) and
# the iface hotplug: it switches dnsmasq's filter_AAAA and prunes stale v6
# default routes, so nothing has to be disabled or re-enabled here.
[ "$(uci -q get network.@globals[0].aw1000_ipv6)" = 1 ] && exit 0
[ -n "$(uci -q get network.lan.ip6assign)" ] || uci -q set network.lan.ip6assign='60'
uci -q set network.@globals[0].aw1000_ipv6='1'
uci -q commit network
exit 0
