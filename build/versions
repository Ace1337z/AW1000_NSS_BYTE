# Pinned revisions for build/build.sh and build/inside.sh.
#
# Every entry is a full 40-char SHA. A branch name would let an upstream
# force-push change the image between two builds of the same commit of this
# repo; an abbreviated SHA makes `src-git` fail with "couldn't find remote ref".
#
# Bump one line at a time and re-run the build: patches in build/patches-*
# are pinned to these trees and fail loudly (not silently) when they no longer
# apply.

# Base tree: OpenWrt with the NSS/EDMA rework (was JuliusBairaktaris/
# openwrt-nss-edma, renamed upstream). Branch nss-edma-rework.
#
# STATUS: this branch is ARCHIVED upstream. Its README says so and points at
# the ppe-nss branch, which is the actively developed tree (kernel 6.18, PPE
# rather than EDMA, NSS packages moved into the feed, no package/nss/nss-tools
# in the tree). We stay here because XT-Martinez's aw1000-feed - the proven
# build this repo follows - is built on exactly this tree, and moving to
# ppe-nss would mean rewriting build/patches-openwrt/0002 (it patches
# package/nss/nss-tools, which no longer exists there) and re-testing the whole
# feed set. The archive tag is archive/nss-edma-rework-final.
OPENWRT_URL="https://github.com/JuliusBairaktaris/openwrt-ppe-nss"
OPENWRT_SHA="65a94490a509895623aae30faa690347903399f2"

# NSS firmware/driver feed. The aw1000-nss branch is the one XT-Martinez's
# proven aw1000-feed builds against (same SHA), and it carries the wwan/ tree
# that kmod-qca-nss-drv is built from.
#
# Note this is NOT JuliusBairaktaris/nss-packages (the tree's own upstream
# feed): that one has edma-nss for the archived branch and ppe-nss for the new
# tree, and neither carries a wwan/ directory. The AW1000's modem packages come
# from this feed plus the vendored copies in wwan/.
NSS_PACKAGES_URL="https://github.com/xhikarishii/nss-packages"
NSS_PACKAGES_SHA="ef05f5c10e6e106fc7ae3d0c67c7fb5c782bc264"

# Common NSS config, toolchain and hardening options, and the QoL overlay.
BUILDER_URL="https://github.com/JuliusBairaktaris/Qualcommax_NSS_Builder"
BUILDER_SHA="67279a6f04eb88a63b641f6940487c22b0da9769"

# Passwall2's dependency feed, pinned at the commit that carries
# Xray-core 26.3.27 (commit d0ebdbb, "xray-core: update to 26.3.27").
# Paired with luci-app-passwall2 26.4.10 (tag 26.4.10-1) in build/feeds.
PASSWALL_PKGS_SHA="d0ebdbb35bd463f5d65455e757027e69aea850d7"

# ---------------------------------------------------------------------------
# Modem manager: QModem, and the phone stack that talks to it.
#
# These two move together and are the one exception to "pin the newest tag":
# the phone daemon needs QModem voice, which lives on QModem main and in no
# release. Both SHAs are recorded in build/feeds as well (that is what
# `scripts/feeds update` reads); they are repeated here so the pairing is
# visible in one place. Change both or neither.
#
#   QMODEM_SHA  main @ 2026-10, after FUjr/QModem#290 (AW1000 voice support)
#   PHONE_SHA   openwrt-aw1000-phone v0.5.0
#
# The phone daemon requires at-daemon >= 3.4.0 and QModem reports 3.4.0_rc3,
# so the pin and the requirement line up.
QMODEM_SHA="c50bc9cd210c7e9686cd7e0796d57ed6a7977b41"
PHONE_SHA="5a5c87471d090f015a0ecaf1f407a8b0082d8e5c"

# QMI driver: wwan/qmi_wwan_q (this tree, 1.5.0-r4), NOT QModem's copy.
# QModem ships driver/quectel_QMI_WWAN under the same binary package name
# (kmod-qmi_wwan_q), so both in one build is a duplicate-package error. The
# QModem QMI drivers are excluded in build/feeds.exclude and the QModem
# INCLUDE_* driver options are off in build/config; this tree's copy is the one
# with the QMAP-netdev and raw-IP handling that NSS offload needs.
