#
# Arcadyan AW1000 on the NSS-EDMA tree -- image config.
#
# Concatenated with devices/common/config from Qualcommax_NSS_Builder (the NSS
# stack, toolchain and hardening options) and then run through `make defconfig`.
# This file wins on any symbol set in both. Every CONFIG_*=y line below is
# verified after defconfig: if one is silently dropped, the build stops instead
# of shipping an image that is missing a feature.
#
# build/config.extra holds best-effort additions that only warn.

## Firmware identity. Without these the image reports itself as plain
## "OpenWrt SNAPSHOT" everywhere - LuCI header, /etc/openwrt_release,
## os-release, the sysupgrade banner and the .manifest filename - which makes
## it impossible to tell which build a router is running.
##
## VERSION_DIST is the name in the LuCI header and the release files;
## VERSION_NUMBER is what sysupgrade shows. VERSION_REPO is deliberately the
## upstream snapshot repo, not a custom one: this image has no package server,
## and pointing it at a URL that does not exist makes `apk update` fail noisily.
## IMAGEOPT gates the whole image-config menu (VERSIONOPT, init options,
## preinit, ...). It defaults to n and nothing in the tree selects it - it is
## a menuconfig-only option - so without this line every VERSION_* symbol
## below is silently dropped by defconfig and the image keeps reporting itself
## as plain "OpenWrt SNAPSHOT".
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="AW1000_NSS_BYTE"
CONFIG_VERSION_NUMBER="1.0"
CONFIG_VERSION_CODE="BYTE"
CONFIG_VERSION_REPO="https://downloads.openwrt.org/snapshots"
# Keep the dist name out of the image filename: the file is already named after
# the device, and a long prefix makes the sysupgrade name harder to read.
# CONFIG_VERSION_CODE_FILENAMES is not set

## Package manager: APK, not OPKG. The tree defaults to this, but pin it so a
## future rebase cannot quietly flip the image back to ipkg.
CONFIG_USE_APK=y
# apk-mbedtls and apk-openssl are a Kconfig choice, and the builder's common
# config already selects openssl - which is what this image wants anyway,
# because passwall2, curl and Tailscale all need libopenssl. Asking for
# mbedtls as well is silently dropped, so it is not requested.
# CONFIG_PACKAGE_apk-openssl is set by the builder
# CONFIG_PACKAGE_apk-mbedtls is not set
# Self-built packages are unsigned; install them with `apk add --allow-untrusted`
# (see README). Signing would need a key baked into every image.
# CONFIG_SIGN_EACH_PACKAGE is not set
# CONFIG_SIGN_FIRMWARE is not set
# CONFIG_SIGNATURE_CHECK is not set
# CONFIG_SIGNED_PACKAGES is not set

## Device: single profile, 1 GB memory class. The subtarget is ours to set:
## the builder's common config leaves it to each device group.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
# Single-profile mode. The device symbol is CONFIG_TARGET_<conf>_<profile>
# (scripts/target-metadata.pl line ~256), which is only emitted when
# TARGET_MULTI_PROFILE is off. With MULTI_PROFILE=y the tree emits a different
# symbol, CONFIG_TARGET_DEVICE_<conf>_<profile>, and this one is silently
# dropped by defconfig - which is what made the first CI build fail with 160
# missing symbols and CONFIG_TARGET_SUBTARGET="generic".
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_arcadyan_aw1000=y
CONFIG_ATH11K_MEM_PROFILE_1G=y
CONFIG_NSS_MEM_PROFILE_HIGH=y

## Cellular WAN offload. Two halves, both required:
##   - NSS_DRV_RMNET_ENABLE builds qca-nss-drv's rmnet_rx node support, and
##     NSS_DRV_C2C_ENABLE gives the n2h node its core-1 hop.
##   - the rmnet-nss module (nss feed, wwan/driver/rmnet-nss) publishes
##     rmnet_nss_callbacks; qmi_wwan_q picks it up at load, marks the QMAP
##     netdevs ARPHRD_RAWIP and hands accelerated packets to it. rmnet_nss_xmit()
##     is what strips the 14-byte Ethernet header the firmware adds.
## qmi_wwan_q only wires its own rmnet_nss hooks when built with
## -DCONFIG_QCA_NSS_DRV, which this package deliberately does not pass (the
## Makefile comment explains: the driver's own hook would claim the same
## rx_handler the qca-nss-drv binder wants). The QMAP netdevs are still forced
## to ARPHRD_RAWIP so ECM classifies them as rawip, and kmod-rmnet-nss is what
## provides the rmnet_nss_callbacks symbol the driver looks up at load time.
##
## In practice the modem path here runs on the CPU, which is what XT-Martinez's
## proven aw1000-feed does too (its qmi_wwan_q is byte-identical to this one,
## and its config sets the same two NSS symbols). byte-ttl keeps ECM off by
## default anyway, because ECM bypasses netfilter and would leak the real TTL,
## so this only becomes relevant when a user runs `nss-offload on` and accepts
## losing the TTL rewrite.
CONFIG_NSS_DRV_RMNET_ENABLE=y
CONFIG_NSS_DRV_C2C_ENABLE=y
## The driver itself. rmnet-nss depends on +kmod-qca-nss-drv, and nothing
## selects it automatically, so without this line defconfig drops BOTH: the
## driver is never built and kmod-rmnet-nss fails its dependency check.
## kmod-qca-nss-dp and nss-firmware come in as its own dependencies.
CONFIG_PACKAGE_kmod-qca-nss-drv=y
# kmod-qca-nss-dp and nss-firmware are NOT requested here: on the EDMA tree the
# data path is the in-tree qca_ppe_nss glue (package/kernel/qca-ppe-nss, pulled
# in by the builder), not the vendor qca-nss-dp + firmware pair. Asking for
# them fails because neither package exists on this branch.
CONFIG_PACKAGE_kmod-rmnet-nss=y

# initramfs FIT for USB boot testing (U-Boot: usbboot 0x44000000 0:4)
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y

## Image size / rootfs compression.
##
## The kernel here is built with CONFIG_SQUASHFS_XZ=y and NOTHING else:
##   target/linux/generic/config-6.12:
##     CONFIG_SQUASHFS_XZ=y
##     # CONFIG_SQUASHFS_ZSTD is not set
##     # CONFIG_SQUASHFS_LZ4 is not set
##     # CONFIG_SQUASHFS_ZLIB is not set
## and package/kernel/linux/modules/fs.mk pins only CONFIG_SQUASHFS_XZ=y in the
## module's KCONFIG. So zstd - the usual "better than xz" answer - would give a
## rootfs the kernel cannot mount. xz or gzip are the only choices, and the
## choice is already made by the kernel build.
##
## CONFIG_SQUASHFS_XZ=y is what image.mk reads to run mksquashfs with
## `-comp xz -Xpreset 9 -Xe` instead of gzip. Measured on a 502 MB tree of
## ARM-ish binaries with this exact invocation:
##
##   config      size      compress   full extract
##   gzip 256K   175.3 MiB     -          640 ms
##   xz  128K    145.1 MiB    92 s       2841 ms
##   xz  256K    140.8 MiB   102 s       2873 ms
##   xz  512K    137.3 MiB   111 s          -
##   xz 1024K    134.4 MiB   125 s       3375 ms
##
## So xz buys 20% over gzip. Block size is the only real knob left, and it is a
## size-vs-random-read tradeoff: 1024 KiB saves 6.4 MiB over 256 KiB but takes
## 17% longer to extract and reads a whole megabyte to serve one small file.
## LuCI is thousands of small files, so that hurts the first load of a page.
##
## 256 KiB stays: it is the tree default (so the best-tested path), within 4 MiB
## of the 128 KiB size, and the extract difference against 128 KiB is under 1%.
## Do not "optimise" this to 1024 KiB for the 6 MiB.
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_SQUASHFS_XZ is NOT set here: it is a kernel symbol, forced to =y by
# the fs-squashfs module's own KCONFIG (package/kernel/linux/modules/fs.mk),
# so it never appears in .config as a package symbol. image.mk reads it to
# pick `-comp xz` for mksquashfs, which is what matters.
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_SQUASHFS_BLOCK_READERS=4
CONFIG_TARGET_SQUASHFS_SMALL_READERS=4
## Kernel compression: left at the tree's XZ (target/linux/generic/config-6.12
## sets CONFIG_KERNEL_XZ=y). gzip decompresses ~3x faster at boot, but the
## difference on a 6 MB kernel is tens of milliseconds on this SoC, and getting
## it means patching the target's kernel config - a change that would have to
## be re-verified against every kernel bump. Not worth it for boot time that is
## already dominated by U-Boot and the modem's first scan.
# CONFIG_KERNEL_ZSTD is not set
# Only squashfs + initramfs are wanted; every other rootfs format just makes
# the build slower and the output directory bigger.
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_UBIFS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set
# CONFIG_TARGET_ROOTFS_JFFS2 is not set
# CONFIG_TARGET_ROOTFS_EROFS is not set
# KALLSYMS_ALL is what actually bloats vmlinux (it keeps every local symbol,
# not just exported ones); the generic kernel config already leaves it off, so
# this only pins it against a rebase. CONFIG_STRIP_KERNEL_EXPORTS is
# deliberately not used: it depends on BROKEN in this tree, so defconfig would
# drop it and the verification step would fail the build.
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_KERNEL is not set
# No opkg/ipk compatibility layer.
# CONFIG_PER_FEED_PACKAGE is not set

## Modem data path: qmi_wwan_q with two QMAP channels + quectel-cm proto.
## uqmi comes with the AW1000's DEVICE_PACKAGES and pulls upstream qmi_wwan,
## which matches the same Quectel IDs as qmi_wwan_q; keep it out. build/
## patches-openwrt/0003 removes it from the device profile, and inside.sh
## fails the build if it comes back through a dependency.
# CONFIG_PACKAGE_uqmi is not set
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan is not set
CONFIG_PACKAGE_kmod-qmi_wwan_q=y
CONFIG_QMI_WWAN_Q_QMAP_MODE=2
CONFIG_PACKAGE_quectel-cm=y
CONFIG_PACKAGE_luci-proto-quectel=y
CONFIG_PACKAGE_sms-tool=y

## Modem pages: SMS conversations, bands, cell scan and lock, AT console
CONFIG_PACKAGE_luci-app-aw1000-modem=y
## modeminfo: the SA/serving-cell page from AW1000_BYTE (vendored in the
## aw1000 feed, see aw1000/luci-app-modeminfo). Reads the modem over sms-tool
## on the same AT port the modem pages use.
CONFIG_PACKAGE_luci-app-modeminfo=y

## Board defaults: wwan interface, LEDs, the theme
CONFIG_PACKAGE_aw1000-defaults=y

## LuCI theme and the Status -> Dashboard page
CONFIG_PACKAGE_luci-theme-footstrap=y
CONFIG_PACKAGE_luci-mod-dashboard=y
CONFIG_PACKAGE_luci-app-footstrap-files=y

## Tools and services
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_htop=y
## Tailscale: NOT installed, available from the feeds. tailscaled is ~13 MB
## of private RSS and the tailnet is a minority use case; `apk add tailscale
## luci-app-tailscale-community` installs it. rc.local's tailscale0 self-heal
## only runs when tailscaled is present, so it behaves correctly either way.
# CONFIG_PACKAGE_tailscale is not set
# CONFIG_PACKAGE_luci-app-tailscale-community is not set
# WireGuard and Wake-on-LAN are not in the image: both are niche here (the
# cellular link is the WAN, and WoL needs a wired LAN peer to wake) and the
# packages stay in the feeds, so `apk add --allow-untrusted luci-proto-wireguard
# wireguard-tools` still works. etherwake goes with luci-app-wol - it existed
# only because that app does not pull the tool it runs.
# CONFIG_PACKAGE_wireguard-tools is not set
# CONFIG_PACKAGE_luci-proto-wireguard is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_etherwake is not set
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_udp-broadcast-relay-redux=y
## netstat: live per-interface counters and the connection view (Ace1337z)
CONFIG_PACKAGE_luci-app-netstat=y
## AW1K LED controller: NOT installed, available from the feed.
##
## Its led-status daemon and aw1000-defaults' aw1000-leds drive the SAME sysfs
## LEDs (blue:5g, blue:signal, green:wifi). Running both means two daemons
## fighting over one LED - whichever wrote last wins, the panel flickers
## between two colour schemes, and the LuCI page shows a state that may not be
## what is on the panel. Rather than ship it disabled and hope, it stays out of
## the image; aw1000-leds owns the panel. Install it if you prefer its
## signal-quality colouring:
##
##   apk add --allow-untrusted luci-app-aw1k-led
##   /etc/init.d/aw1000-leds disable; /etc/init.d/aw1000-leds stop
##   uci set aw1000_leds.main.enabled='0'; uci commit aw1000_leds
##   /etc/init.d/led-status enable;  /etc/init.d/led-status start
# CONFIG_PACKAGE_luci-app-aw1k-led is not set
## vnstat: long-term traffic accounting, history kept in /etc/vnstat (see
## byte/files/etc/config/vnstat) so it survives a reboot
CONFIG_PACKAGE_vnstat2=y
CONFIG_PACKAGE_vnstati2=y
CONFIG_PACKAGE_luci-app-vnstat2=y

## SQM. The NSS build ships sqm-scripts pinned to the fork with hw_ppe
## offload (builder patch), so shaping rides the NSS instead of the CPU.
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y

## Proxy: Passwall2 only, at 26.4.10 with Xray-core 26.3.27 (pinned in
## build/feeds). Nikki (sing-box/mihomo) and OpenClash are carried in the
## feeds so they can be installed later, but all three install the same
## TPROXY/nftables hooks and must not be enabled together.
CONFIG_PACKAGE_luci-app-passwall2=y
# Nftables transparent proxy (firewall4 is what this tree ships).
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy=n
# INCLUDE_IPv6_Nat depends on PACKAGE_ip6tables (the iptables backend).
# This image is nftables-only, so the option cannot be selected and asking for
# it just trips the verification step. IPv6 NAT for passwall2 is handled by
# the nftables ruleset instead.
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_IPv6_Nat is not set
# Core protocol support. xray-core is a hard dependency of the LuCI app
# already; the pins in build/feeds make it 26.3.27.
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Server=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Hysteria=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_tuic_client=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
CONFIG_PACKAGE_shadowsocks-rust-ssserver=y
CONFIG_PACKAGE_simple-obfs-client=y
CONFIG_PACKAGE_v2ray-plugin=y
CONFIG_PACKAGE_haproxy=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_hysteria=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_resolveip=y
# QUIC / HTTP3. Xray and sing-box speak QUIC over UDP/443; the kernel needs
# the conntrack helper and the nft UDP handling for it to survive NAT, and
# dnsmasq must not filter HTTPS/SVCB records (filter_aaaa stays 0 in
# byte/files/etc/config/dhcp for the same reason).
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-udptunnel4=y
CONFIG_PACKAGE_kmod-udptunnel6=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-nat=y
# UCI/JSON helpers the three proxy apps and their LuCI pages rely on
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_lua=y
CONFIG_PACKAGE_libuci-lua=y

## Nikki, OpenClash and AdGuard Home are installed only on request, but every
## dependency each of them declares is already in the image, so `apk add`
## resolves offline against the image's own packages and does not pull a tree.
##
## Checked against each Makefile:
##   nikki            +ca-bundle +curl +yq firewall4 +ip-full +kmod-inet-diag
##                    +kmod-nft-socket +kmod-nft-tproxy +kmod-tun +kmod-dummy
##                    +mihomo
##   mihomo-meta      +ca-bundle +ip-full +kmod-inet-diag +kmod-tun
##   luci-app-nikki   +luci-base +nikki
##   luci-app-openclash +dnsmasq-full +bash +curl +ca-bundle +ip-full +ruby
##                    +ruby-yaml +kmod-tun +unzip
##   adguardhome      +ca-bundle          (static Go binary, nothing else)
##   luci-app-adguardhome +ca-certs +curl (ca-certs is PROVIDED by
##                    ca-certificates, already selected)
##
## The kmods and firewall4/dnsmasq-full are selected above; these are the
## userland ones plus the two kmods that were missing.
CONFIG_PACKAGE_yq=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_firewall4=y

## AdGuard Home: NOT installed, available from the feeds.
##
## It is a ~30 MB Go binary plus a web root; baking it into the image costs
## more space than most of the rest of the added packages combined, and the
## people who want it are a minority. It is built as a package and published
## next to the image, so `apk add adguardhome luci-app-adguardhome` installs it
## on demand. luci-app-custom (below) is the one-click installer for the
## AdGuard + PassWall2 DNS chain.
# CONFIG_PACKAGE_adguardhome is not set
# CONFIG_PACKAGE_luci-app-adguardhome is not set
## Dependencies those two need are already in the image so the on-demand
## install does not pull a tree: ca-bundle, curl, and the nft/conntrack set
## listed under QUIC above. AdGuard Home itself is a static Go binary and
## needs nothing else at runtime.

## BYTE runtime: TTL/HopLimit rewrite, MTU clamp, IPv6 sanity, self-check.
# The nftables source package builds nftables-json (and nftables-nojson);
# there is no bare `nftables` binary package on this tree.
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y

## RAM swap via zram: 433 MB of compressed swap on a 1 GB box.
##
## zram-swap is the script; kmod-zram is what it needs, and the compressor is a
## separate module. lzo-rle is chosen in byte/files/etc/config/system because it
## is the fastest and the only one this kernel ships: CONFIG_CRYPTO_LZ4 is off
## and there is no *lz4* module in /lib/modules, so configuring 'lz4' makes
## zram-swap log "compression algorithm 'lz4' is not supported", exit 0 anyway,
## and leave a 433 MB device with 0 kB of swap. Pinning the backend here means
## the symbol cannot be silently dropped by a rebase.
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZORLE=y
# lz4/lz4hc/zstd backends stay off: no module and no userspace consumer.
# CONFIG_KERNEL_ZRAM_BACKEND_LZ4 is not set
# CONFIG_KERNEL_ZRAM_BACKEND_LZ4HC is not set
# CONFIG_KERNEL_ZRAM_BACKEND_ZSTD is not set
# Writeback is forced off by the kernel package's own KCONFIG
# (CONFIG_ZRAM_WRITEBACK=n): it would need a backing block device, and there is
# none on this board. Not a Kconfig symbol here, so it is not set from this
# file.

## One page for the image-specific switches: TTL/HopLimit rewrite, the
## NSS/ECM offload toggle, and the AdGuard Home + PassWall2 DNS setup
## (Ace1337z's installer, vendored). Both AdGuard packages are installed on
## demand, not baked in.
CONFIG_PACKAGE_luci-app-custom=y

## RJ11 phone port: SLIC kernel module, the daemon and its LuCI page.
## fxsd drives the AT modem through the ubus at-daemon object, so that tiny
