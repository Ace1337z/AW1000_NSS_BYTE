
config dnsmasq
	option domainneeded '1'
	option boguspriv '1'
	option filterwin2k '0'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option local '/lan/'
	option domain 'lan'
	option expandhosts '1'
	option min_cache_ttl '3600'
	option use_stale_cache '3600'
	option cachesize '8000'
	option nonegcache '1'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option nonwildcard '1'
	option localservice '1'
	option dns_redirect '1'
	option ednspacket_max '1232'
	option filter_aaaa '0'
	option filter_a '0'
	option localuse '1'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option dhcpv4 'server'
	# IPv6 to LAN clients. ra 'server' advertises the delegated prefix and
	# dhcpv6 'server' hands out addresses from it; both ra_flags are needed -
	# managed-config tells clients to ask DHCPv6 for an address, other-config
	# to ask for DNS/NTP. With only other-config (what this file used to
	# carry) clients configure themselves from the prefix but never get a
	# DHCPv6 lease, so half the clients end up with no usable v6 address.
	# odhcpd.defaults in the base tree sets both; this file has to as well,
	# because it replaces the generated one.
	option ra 'server'
	option dhcpv6 'server'
	list ra_flags 'managed-config'
	list ra_flags 'other-config'
	option max_preferred_lifetime '2700'
	option max_valid_lifetime '5400'
	# The LAN is the master for prefix delegation: it is where the modem's
	# delegated prefix (network.<alias>v6, created by QModem) is
	# re-advertised to LAN clients.
	option master '1'

config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/tmp/hosts/odhcpd'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '4'

