#!/bin/sh
# Re-apply the cellular MTU after every netifd ifup.
#
# quectel-cm destroys and recreates the wwan0 QMAP channels on each reconnect,
# which resets the MTU back to the kernel default of 1500. A 1500 MTU on an LTE/NR bearer causes
# a PMTU blackhole: full-size packets are dropped upstream while small ones
# pass, so large transfers and VoIP stall intermittently.
[ "$ACTION" = "ifup" ] || exit 0

# QModem names the modem interfaces after the alias in /etc/config/qmodem
# (<alias> and <alias>v6, wwan0/wwan0v6 by default), so match the device
# prefix as well as the legacy names.
case "$INTERFACE" in
	wan | wan6 | wan_6 | wanv6 | wwan* | *qmodem*) ;;
	*) exit 0 ;;
esac

MTU=1420
for dev in wwan0 wwan0_1 wwan0_2; do
	ip link show "$dev" >/dev/null 2>&1 || continue
	cur=$(ip link show "$dev" 2>/dev/null | grep -oE 'mtu [0-9]+' | cut -d' ' -f2)
	[ "$cur" = "$MTU" ] && continue
	ip link set dev "$dev" mtu "$MTU" 2>/dev/null &&
		logger -t byte-mtu "hotplug $INTERFACE: $dev ${cur:-?} -> $MTU"
done
exit 0
