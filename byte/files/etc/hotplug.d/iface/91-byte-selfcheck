#!/bin/sh
# Re-run the tuning self-check right after an MTU-bearing interface comes up.
#
# quectel-cm recreates the wwan channels on every reconnect and byte-selfcheck
# runs once at boot (S99) - which on a slow carrier scan can be before the
# first connect. This keeps the log truthful about the *current* state.
#
# Mirrors 90-byte-mtu, which runs immediately before this and fixes the MTU:
# checking before that would report a mismatch byte-mtu is about to repair.
[ "$ACTION" = "ifup" ] || exit 0

# QModem names the modem interfaces after the alias in /etc/config/qmodem
# (<alias> and <alias>v6, wwan0/wwan0v6 by default), so match the device
# prefix as well as the legacy names.
case "$INTERFACE" in
	wan | wan6 | wan_6 | wanv6 | wwan* | *qmodem*) ;;
	*) exit 0 ;;
esac

# Debounce: netifd fires several events per ifup (up, renew, ...) and each
# would re-log an identical full report.
LOCK=/var/run/byte-selfcheck.lock
now=$(date +%s 2>/dev/null || echo 0)
last=$(cat "$LOCK" 2>/dev/null || echo 0)
[ $((now - last)) -lt 20 ] && exit 0
echo "$now" > "$LOCK" 2>/dev/null

/etc/init.d/byte-selfcheck start >/dev/null 2>&1
exit 0
