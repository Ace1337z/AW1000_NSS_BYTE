#!/bin/sh
# AW1000_NSS_BYTE runtime defaults, applied once on first boot.
#
# Everything here is idempotent and guarded by a UCI marker, because the file
# ships in the image and therefore runs again after every settings-keeping
# sysupgrade. Clear the marker to have it applied again:
#
#   uci delete system.@system[0].byte_defaults && uci commit system
#
# This file is named 99-byte so it runs *after* the NSS feed's own
# 98-nss-offload. That ordering matters: 98-nss-offload is what sets
# packet_steering='0' and flow_offloading='0', and we agree with both (see the
# packet steering note below), so nothing here needs to win a race.
[ "$(uci -q get system.@system[0].byte_defaults)" = 1 ] && exit 0

log() { logger -t byte-defaults "$*"; }

# ---- TTL / HopLimit rewrite on the modem uplink -----------------------------
# The point of this image, and enabled here even when /etc/config survived an
# upgrade.
#
# The service is QModem's own qmodem_ttl (luci-app-qmodem-ttlfw4), not the
# in-tree byte-ttl this image used to ship. Its init script writes
# /etc/nftables.d/99-reset-ttl-from-br-lan.nft from /etc/config/qmodem_ttl and
# stops ECM, so there is exactly one ruleset owning the rewrite. Configuration
# lives at Modem -> QModem -> TTL; this only supplies the first-boot default
# (on, TTL 64 on both families) and never overwrites a value already set.
if [ -x /etc/init.d/qmodem_ttl ]; then
	uci -q get qmodem_ttl.main >/dev/null 2>&1 || uci -q set qmodem_ttl.main=main
	[ -n "$(uci -q get qmodem_ttl.main.enable)" ] || \
		uci -q set qmodem_ttl.main.enable='1'
	[ -n "$(uci -q get qmodem_ttl.main.ttl)" ] || \
		uci -q set qmodem_ttl.main.ttl='64'
	uci -q commit qmodem_ttl

	/etc/init.d/qmodem_ttl enable 2>/dev/null
	/etc/init.d/qmodem_ttl restart 2>/dev/null
	log "qmodem_ttl enabled (TTL $(uci -q get qmodem_ttl.main.ttl))"
fi

# ---- MTU clamp -------------------------------------------------------------
# The modem bearer cannot carry 1500: full-size packets are dropped upstream
# (PMTU blackhole) while small ones pass, which stalls large transfers and
# VoIP. Re-applied by /etc/hotplug.d/iface/90-byte-mtu on every ifup.
if [ -x /etc/init.d/byte-mtu ]; then
	/etc/init.d/byte-mtu enable 2>/dev/null
	/etc/init.d/byte-mtu start 2>/dev/null
	log "byte-mtu enabled"
fi

# ---- Modem uplink interface heal -------------------------------------------
# QModem's hang/redial path deletes network.<alias> and network.<alias>v6, and
# only puts them back if the dial worker gets that far. Without this the WAN
# page goes blank until someone re-creates the interface by hand. The helper
# re-creates exactly the two sections QModem would, carrying modem_config, so
# QModem still considers them its own and keeps dialling through them.
if [ -x /etc/init.d/qmodem-iface-heal ]; then
	/etc/init.d/qmodem-iface-heal enable 2>/dev/null
	/etc/init.d/qmodem-iface-heal start 2>/dev/null
	log "qmodem-iface-heal enabled"
fi

# ---- IPv6 sanity -----------------------------------------------------------
# IPv6 stays enabled; this only demotes it to IPv4 when the carrier delegates
# a prefix but provides no routable WAN address, which would otherwise make
# clients prefer a dead path.
#
# Ownership note: this never writes /etc/config/network. QModem owns
# network.<alias> / network.<alias>v6 and refuses to dial through a section
# that is tagged with a different modem_config, so a hardcoded "wan"/"wanv6"
# pair here (what this image used to ship, copied from a build where the alias
# *was* wan) would leave this image with two uplinks and QModem dialling none
# of them. byte-v6-check reads the alias from /etc/config/qmodem instead.
if [ -x /etc/init.d/byte-v6 ]; then
	/etc/init.d/byte-v6 enable 2>/dev/null
	log "byte-v6 enabled"
fi

# ---- CPU spread ------------------------------------------------------------
# The modem's USB interrupts all land on one core; with passwall2 doing
# userspace crypto on top, that core saturates long before the link does.
if [ -x /etc/init.d/byte-affinity ]; then
	/etc/init.d/byte-affinity enable 2>/dev/null
	/etc/init.d/byte-affinity start 2>/dev/null
	log "byte-affinity enabled"
fi

# ---- Packet steering -------------------------------------------------------
# OFF, matching the NSS feed's own 98-nss-offload default. Its comment records
# the measurement on this board (Wi-Fi client to wired host through the
# router, two runs each):
#
#   749 and 800 Mbit/s with the service disabled
#   619 and 626 Mbit/s with it at its default
#
# plus n2h_rx_queue drops (158 and 83) where disabling it produced none. The
# reason is that Linux RPS assumes one host NAPI per hardware queue, which does
# not describe a datapath where the firmware delivers through N2H - the NSS
# already spreads work over its queues, so steering duplicates it.
#
# We keep the NSS setting rather than overriding it. Turn it on manually if you
# run passwall2 on a CPU-bound workload and want per-core spread:
#
#   uci set network.@globals[0].packet_steering='1'
#   uci commit network && /etc/init.d/packet_steering restart
#
# (byte-affinity already spreads the modem USB interrupts and sets RPS on the
# wwan* netdevs, which is the part that matters for cellular throughput and
# does not touch the NSS delivery path.)
log "packet_steering left off (NSS default; see 99-byte to enable)"

# ---- NSS/ECM flow offload --------------------------------------------------
# ECM bypasses netfilter entirely, so offloaded flows keep their original TTL
# and defeat the rewrite above. QModem's qmodem_ttl service already stops it
# when it starts; doing it here as well keeps the two from racing on first boot
# and gives a deterministic state before anything is dialled. Keep it installed
# - /usr/bin/nss-offload can turn it on - but off by default: TTL correctness
# beats offload throughput.
if [ -x /etc/init.d/qca-nss-ecm ]; then
	/etc/init.d/qca-nss-ecm stop 2>/dev/null
	/etc/init.d/qca-nss-ecm disable 2>/dev/null
	log "qca-nss-ecm disabled (TTL rewrite takes priority)"
fi

# ---- Theme -----------------------------------------------------------------
# footstrap is the only theme in the image; pin it in case a settings-keeping
# upgrade carried over another mediaurlbase.
[ -d /www/luci-static/footstrap ] && uci -q set luci.main.mediaurlbase='/luci-static/footstrap'

uci set system.@system[0].byte_defaults='1'
uci commit system
uci commit network
uci commit luci 2>/dev/null

log "defaults applied"
exit 0
