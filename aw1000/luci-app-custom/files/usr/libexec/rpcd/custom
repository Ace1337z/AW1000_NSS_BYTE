#!/bin/sh
# rpcd backend for luci-app-custom.
#
# Two switches that are specific to this image and would otherwise need an SSH
# session, plus a read-only view of the TTL service so the page can explain the
# one real interaction between them:
#
#   nss_offload /usr/bin/nss-offload      - ECM fast path; it bypasses
#                                           netfilter, so it cannot coexist
#                                           with any TTL rewrite
#   agh         AdGuard Home + PassWall2  - the DNS chain installer
#   (status)    /etc/config/qmodem_ttl    - read-only, owned by
#                                           luci-app-qmodem-ttlfw4
#
# TTL is deliberately not settable here. QModem's qmodem_ttl service owns the
# rewrite (its init writes /etc/nftables.d/99-reset-ttl-from-br-lan.nft from
# /etc/config/qmodem_ttl and stops ECM when it starts), so the single source of
# truth is Modem -> QModem -> TTL. This page only reports what that service is
# doing, because it is the reason the offload switch above is off by default.
#
# Everything is read from the same files the init scripts use, so the page and
# the shell can never disagree.

. /usr/share/libubox/jshn.sh

NSS_OFFLOAD=/usr/bin/nss-offload
ECM_INIT=/etc/init.d/qca-nss-ecm
ECM_ACCEL=/sys/kernel/debug/ecm/ecm_classifier_default/accel_mode
TTL_INIT=/etc/init.d/qmodem_ttl
TTL_RULESET=/etc/nftables.d/99-reset-ttl-from-br-lan.nft
AGH_SCRIPT=/usr/libexec/agh-passwall2-install.sh

uciget() { uci -q get "$1" 2>/dev/null; }

# Is ECM actually loaded? That, not the init script's enabled flag, is what
# decides whether the fast path is live.
ecm_loaded() {
	grep -q '^qca_nss_ecm ' /proc/modules 2>/dev/null && return 0
	[ -d /sys/module/qca_nss_ecm ] && return 0
	return 1
}

pkg_installed() {
	if command -v apk >/dev/null 2>&1; then
		apk info -e "$1" >/dev/null 2>&1
	else
		opkg list-installed 2>/dev/null | grep -q "^$1 "
	fi
}

# Set by nss-offload itself: 0=accel 1=no 2=dont-care. Empty when ECM is not
# loaded or debugfs is not mounted.
ecm_accel_mode() {
	cat "$ECM_ACCEL" 2>/dev/null
}

do_status() {
	local ttl_en ttl_v ttl_active ttl_installed
	local ecm aghen pwred dnsport

	ttl_en="$(uciget qmodem_ttl.main.enable)"; [ -n "$ttl_en" ] || ttl_en=0
	ttl_v="$(uciget qmodem_ttl.main.ttl)";     [ -n "$ttl_v" ]  || ttl_v=64

	# "Active" means the service ran and its ruleset is on disk. The UCI flag
	# alone lies after a failed firewall restart, and the ruleset alone lies
	# after the user disabled the service without a restart.
	if [ -x "$TTL_INIT" ] && [ "$ttl_en" = "1" ] && [ -s "$TTL_RULESET" ]; then
		ttl_active=1
	else
		ttl_active=0
	fi
	[ -x "$TTL_INIT" ] && ttl_installed=1 || ttl_installed=0

	ecm_loaded && ecm=1 || ecm=0
	aghen="$(uciget adguardhome.@adguardhome[0].enabled)"; [ -n "$aghen" ] || aghen=0
	pwred="$(uciget passwall2.@global[0].dns_redirect)";   [ -n "$pwred" ] || pwred=1
	dnsport="$(uciget dhcp.@dnsmasq[0].port)";             [ -n "$dnsport" ] || dnsport=53

	json_init
	json_add_object "status"
	# TTL (read-only; owned by luci-app-qmodem-ttlfw4)
	json_add_boolean "ttl_installed" "$ttl_installed"
	json_add_boolean "ttl_enabled"   "$ttl_en"
	json_add_int     "ttl_value"     "$ttl_v"
	json_add_boolean "ttl_active"    "$ttl_active"
	# NSS offload
	json_add_boolean "nss_available" "$([ -x "$NSS_OFFLOAD" ] && echo 1 || echo 0)"
	json_add_boolean "ecm_loaded"    "$ecm"
	json_add_boolean "ecm_installed" "$([ -x "$ECM_INIT" ] && echo 1 || echo 0)"
	json_add_string  "ecm_accel"     "$(ecm_accel_mode)"
	# AdGuard / PassWall2
	json_add_boolean "agh_installed"      "$(pkg_installed adguardhome && echo 1 || echo 0)"
	json_add_boolean "agh_luci_installed" "$(pkg_installed luci-app-adguardhome && echo 1 || echo 0)"
	json_add_boolean "agh_enabled"        "$aghen"
	json_add_boolean "passwall_installed" "$(pkg_installed luci-app-passwall2 && echo 1 || echo 0)"
	json_add_int     "dnsmasq_port"       "$dnsport"
	json_add_boolean "passwall_redirect"  "$pwred"
	json_add_string  "agh_installer"      "$([ -x "$AGH_SCRIPT" ] && echo present || echo missing)"
	json_close_object
	json_dump
}

# ---- NSS offload -----------------------------------------------------------
do_nss_set() {
	local want out rc

	json_get_var want state

	if [ ! -x "$NSS_OFFLOAD" ]; then
		json_init; json_add_boolean "ok" 0
		json_add_string "output" "nss-offload not installed"
		json_dump; return
	fi

	# Enabling offload while qmodem_ttl is running would silently undo the
	# rewrite: ECM forwards established flows without consulting netfilter,
	# and QModem's service stops ECM precisely so that cannot happen. Refuse
	# rather than hand back a fast path that quietly breaks the TTL.
	if [ "$want" = "1" ] && [ "$(uciget qmodem_ttl.main.enable)" = "1" ]; then
		json_init; json_add_boolean "ok" 0
		json_add_string "output" \
			"Refusing to enable NSS offload: the TTL rewrite (Modem -> QModem -> TTL) is enabled. Disable it there first."
		json_dump; return
	fi

	if [ "$want" = "1" ]; then
		out="$("$NSS_OFFLOAD" on 2>&1)"
	else
		out="$("$NSS_OFFLOAD" off 2>&1)"
	fi
	rc=$?

	json_init
	json_add_boolean "ok" "$([ "$rc" = 0 ] && echo 1 || echo 0)"
	json_add_string "output" "$out"
	json_dump
}

# ---- AdGuard Home + PassWall2 ----------------------------------------------
do_agh_install() {
	local out rc

	if [ ! -x "$AGH_SCRIPT" ]; then
		json_init; json_add_boolean "ok" 0
		json_add_string "output" "installer missing at $AGH_SCRIPT"
		json_dump; return
	fi
	out="$("$AGH_SCRIPT" 2>&1)"
	rc=$?
	printf '%s\n' "$out" >/var/log/agh-passwall2.log

	json_init
	json_add_boolean "ok" "$([ "$rc" = 0 ] && echo 1 || echo 0)"
	json_add_int "rc" "$rc"
	json_add_string "output" "$out"
	json_dump
}

do_agh_revert() {
	uci -q set dhcp.@dnsmasq[0].port='53'
	uci -q commit dhcp
	uci -q set adguardhome.@adguardhome[0].enabled='0'
	uci -q commit adguardhome 2>/dev/null
	[ -x /etc/init.d/adguardhome ] && {
		/etc/init.d/adguardhome stop    >/dev/null 2>&1
		/etc/init.d/adguardhome disable >/dev/null 2>&1
	}
	rm -f /tmp/dnsmasq.d/dnsmasq-passwall2.conf
	/etc/init.d/dnsmasq restart >/dev/null 2>&1

	json_init
	json_add_boolean "ok" 1
	json_add_string "output" "dnsmasq restored to :53, AdGuard Home stopped"
	json_dump
}

case "$1" in
	status)
		do_status
		;;
	nss_set)
		do_nss_set
		;;
	agh_install)
		do_agh_install
		;;
	agh_revert)
		do_agh_revert
		;;
	*)
		json_init
		json_add_boolean "ok" 0
		json_add_string "output" "unknown method: $1"
		json_dump
		;;
esac
