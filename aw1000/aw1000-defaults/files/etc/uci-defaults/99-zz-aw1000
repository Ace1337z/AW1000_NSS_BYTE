#!/bin/sh
# Runs once, after the board defaults and before the builder's 999-QOL_config.
#
# The LAN stays at OpenWrt's 192.168.1.1/24. Don't set network.lan.ipaddr
# here: config_generate writes it as a CIDR list without a netmask, so a bare
# address left the LAN a /32 with no DHCP (the 2026-10-03/05 releases), and a
# settings-keeping upgrade from another build would lose its LAN address.
#
# The file ships in the image, so it runs again after every settings-keeping
# sysupgrade; the marker keeps it from resetting what was changed since.
[ "$(uci -q get system.@system[0].aw1000_defaults)" = 1 ] && exit 0

. /lib/functions.sh

# Modem data path: entirely QModem's.
#
# There is deliberately NO network.wwan (or wwan_6) interface created here.
# QModem owns the network.<alias> sections it dials through:
#
#   - /etc/board.d/03_qmodem maps the AW1000's USB modem (slot 4-1) to the
#     alias wwan0, so modem_dial.sh creates network.wwan0 with
#     proto='qmodem_runtime' and modem_config=<the qmodem section name>.
#   - modem_dial.sh refuses to touch an interface it does not own:
#     qmodem_interface_owned() passes only when network.$1.modem_config equals
#     its own instance name, or when network.$1 does not exist at all. A
#     pre-created network.wwan with some other proto therefore does not merely
#     get overwritten - it makes QModem skip the interface and never dial.
#   - proto 'qmodem_runtime' (/lib/netifd/proto/qmodem_runtime.sh) is the only
#     handler for these interfaces, and it exists only in QModem. The old
#     proto='quectel' from luci-proto-quectel is gone: that package and its
#     quectel-cm dialer are not in the image any more (build/config).
#
# qmi_wwan_q is still built here and still puts IPv4/IPv6 on wwan0_1/wwan0_2
# (qmap_mode=2, see build/config); QModem is what dials and hands the result to
# netifd, and it adds the interface to the wan zone itself (append_to_fw_zone).
# Setting the APN and PDP type is QModem -> Network Configuration, not UCI here.
#
# IPv6 being *available* is not the same as IPv6 *working*: plenty of carriers
# hand out a prefix and never route it, and then every client prefers IPv6
# (RFC 6724) and sends traffic into a black hole - "the internet is fine but
# nothing loads". byte-v6-check measures real connectivity and only demotes to
# IPv4 when it actually fails, so leaving IPv6 on in QModem is safe.

# The modem interfaces go in the wan zone, and QModem does that itself when it
# creates them (qmodem_wan_zone + append_to_fw_zone). Nothing to do here - but
# if an interface created by an older image survived a settings-keeping
# upgrade, drop it so QModem is free to own the name again. Only an interface
# without a modem_config is touched; one QModem created is left alone.
for net in wwan wwan_6; do
	if uci -q get "network.$net" >/dev/null && \
	   [ -z "$(uci -q get "network.$net.modem_config")" ]; then
		uci -q delete "network.$net"
	fi
done

# LEDs: signal, 5G, internet and phone belong to aw1000-leds, Wi-Fi to a
# trigger.
drop_led() {
	local sysfs

	config_get sysfs "$1" sysfs
	case "$sysfs" in
	*:5g | *:signal | green:internet | green:wifi | green:phone)
		uci -q delete "system.$1"
		;;
	esac
}
config_load system
config_foreach drop_led led

uci set system.led_wifi='led'
uci set system.led_wifi.name='Wi-Fi'
uci set system.led_wifi.sysfs='green:wifi'
# Steady while the 5 GHz AP is up: ath11k registers no phyNtpt throughput
# trigger (only rx/tx/assoc/radio), so use the netdev trigger's link state.
uci set system.led_wifi.trigger='netdev'
uci set system.led_wifi.dev='phy0-ap0'
uci set system.led_wifi.mode='link'

# USB drives: mount anything plugged in under /mnt/<device>, no fstab entry
# needed.
uci -q get fstab.@global[0] >/dev/null || uci add fstab global >/dev/null
uci set fstab.@global[0].anon_mount='1'
uci set fstab.@global[0].auto_mount='1'

# Theme
[ -d /www/luci-static/footstrap ] && uci -q set luci.main.mediaurlbase='/luci-static/footstrap'

uci set system.@system[0].aw1000_defaults='1'

uci commit network
uci commit firewall
uci commit system
uci commit fstab
uci commit luci

exit 0
