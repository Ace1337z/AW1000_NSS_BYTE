#!/bin/sh
# rpcd backend for luci-app-agh-passwall2.
#
# Exposes three ubus methods under the "agh-passwall2" object:
#   status  -> whether AdGuard Home and PassWall2 are installed, and the
#              current DNS wiring (who owns port 53, dnsmasq's port, whether
#              passwall2 still hijacks DNS)
#   install -> run the vendored Ace1337z installer
#   revert  -> put dnsmasq back on port 53 and stop AdGuard Home
#
# The installer is vendored at /usr/libexec/agh-passwall2-install.sh rather
# than fetched at runtime: this image has no guaranteed WAN at the moment the
# user clicks the button, and piping a remote script into a root shell is not
# something a LuCI button should do.

. /usr/share/libubox/jshn.sh

SCRIPT=/usr/libexec/agh-passwall2-install.sh
LOG=/var/log/agh-passwall2.log

# Read one uci value, empty string when unset.
uciget() { uci -q get "$1" 2>/dev/null; }

# Is a package installed? apk is what this image uses; opkg is kept for the
# case where someone flashes this app onto an ipk build.
pkg_installed() {
	if command -v apk >/dev/null 2>&1; then
		apk info -e "$1" >/dev/null 2>&1
	else
		opkg list-installed 2>/dev/null | grep -q "^$1 "
	fi
}

do_status() {
	local dnsmasq_port agh_on passwall_on agh53 pw_redirect

	dnsmasq_port="$(uciget dhcp.@dnsmasq[0].port)"
	[ -n "$dnsmasq_port" ] || dnsmasq_port=53
	agh_on="$(uciget adguardhome.@adguardhome[0].enabled)"
	[ -n "$agh_on" ] || agh_on=0
	passwall_on="$(uciget passwall2.@global[0].enabled)"
	[ -n "$passwall_on" ] || passwall_on=0
	pw_redirect="$(uciget passwall2.@global[0].dns_redirect)"
	[ -n "$pw_redirect" ] || pw_redirect=1

	# Who actually holds :53 right now.
	agh53=0
	if command -v netstat >/dev/null 2>&1; then
		netstat -ln 2>/dev/null | grep -qE '(^|[^0-9])0\.0\.0\.0:53[[:space:]]|:::53[[:space:]]' && agh53=1
	elif command -v ss >/dev/null 2>&1; then
		ss -ln 2>/dev/null | grep -q ':53 ' && agh53=1
	fi

	json_init
	json_add_object "status"
	json_add_boolean "agh_installed" "$(pkg_installed adguardhome && echo 1 || echo 0)"
	json_add_boolean "agh_luci_installed" "$(pkg_installed luci-app-adguardhome && echo 1 || echo 0)"
	json_add_boolean "passwall_installed" "$(pkg_installed luci-app-passwall2 && echo 1 || echo 0)"
	json_add_boolean "agh_enabled" "$agh_on"
	json_add_boolean "passwall_enabled" "$passwall_on"
	json_add_int "dnsmasq_port" "$dnsmasq_port"
	json_add_int "passwall_dns_redirect" "$pw_redirect"
	json_add_boolean "port53_in_use" "$agh53"
	json_add_string "installer" "$([ -x "$SCRIPT" ] && echo present || echo missing)"
	json_close_object
	json_dump
}

do_install() {
	if [ ! -x "$SCRIPT" ]; then
		json_init
		json_add_boolean "ok" 0
		json_add_string "output" "installer missing at $SCRIPT"
		json_dump
		return
	fi

	# Run it, capture output for the UI, and keep a copy in the log. The
	# installer is idempotent and backs up every file it touches.
	out="$("$SCRIPT" 2>&1)"
	rc=$?
	printf '%s\n' "$out" >"$LOG"

	json_init
	json_add_boolean "ok" "$([ "$rc" = 0 ] && echo 1 || echo 0)"
	json_add_int "rc" "$rc"
	json_add_string "output" "$out"
	json_dump
}

do_revert() {
	# Put dnsmasq back on :53 and stop AdGuard Home, which is what the
	# installer's own README documents as the manual revert.
	uci -q set dhcp.@dnsmasq[0].port='53'
	uci -q commit dhcp
	if [ -x /etc/init.d/adguardhome ]; then
		/etc/init.d/adguardhome stop  >/dev/null 2>&1
		/etc/init.d/adguardhome disable >/dev/null 2>&1
	fi
	uci -q set adguardhome.@adguardhome[0].enabled='0'
	uci -q commit adguardhome 2>/dev/null
	rm -f /tmp/dnsmasq.d/dnsmasq-passwall2.conf
	/etc/init.d/dnsmasq restart >/dev/null 2>&1

	json_init
	json_add_boolean "ok" 1
	json_add_string "output" "dnsmasq restored to :53, AdGuard Home stopped"
	json_dump
}

case "$1" in
	status)  do_status  ;;
	install) do_install ;;
	revert)  do_revert  ;;
	*)
		json_init
		json_add_boolean "ok" 0
		json_add_string "output" "unknown method: $1"
		json_dump
		;;
esac
