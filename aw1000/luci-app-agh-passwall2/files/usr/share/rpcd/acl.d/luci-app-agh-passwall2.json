{
	"luci-app-agh-passwall2": {
		"description": "Grant access to the AdGuard Home + PassWall2 installer",
		"read": {
			"ubus": {
				"agh-passwall2": [ "status" ]
			},
			"uci": [ "dhcp", "adguardhome", "passwall2" ]
		},
		"write": {
